# Set these in Netlify (Site configuration > Environment variables), not in the repo.
# Neon connection string (Neon console > Connect, pooled).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any long random string; signs the login cookie.
SESSION_SECRET=
# Comma-separated GitHub logins allowed to sign in.
ALLOWED_GITHUB_LOGINS=rectornero
